```{=html}
<div class="pub-list">
<% for (const item of items) { %>
<div class="pub" <%= metadataAttrs(item) %>>
<div class="pub-year"><%= item.year %></div>
<div class="pub-body">
<div class="pub-title"><%= item.title %></div>
<div class="pub-authors"><%= String(item.authors || '').replace('Motyka, P.', '<strong>Motyka, P.</strong>') %></div>
<div class="pub-venue"><em><%= item.venue %></em></div>
<div class="pub-links">
<% if (item.doi) { %><a class="badge-link" href="<%= item.doi %>">DOI</a><% } %>
<% if (item.pdf) { %><a class="badge-link" href="<%= item.pdf %>">PDF</a><% } %>
<% if (item.preprint) { %><a class="badge-link" href="<%= item.preprint %>">Preprint</a><% } %>
<% if (item.code) { %><a class="badge-link" href="<%= item.code %>">Code &amp; data</a><% } %>
<% if (item.data) { %><a class="badge-link" href="<%= item.data %>">Data</a><% } %>
</div>
</div>
</div>
<% } %>
</div>
```
